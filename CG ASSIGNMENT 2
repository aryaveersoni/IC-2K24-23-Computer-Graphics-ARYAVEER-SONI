#include <iostream>
#include <graphics.h>
#include <cmath>

using namespace std;

int main() {
    int gd = DETECT, gm;
    int x1, y1, x2, y2;

    // 1. Accept starting point (x1, y1) and ending point (x2, y2) as input
    cout << "Enter the starting coordinates (x1, y1): ";
    cin >> x1 >> y1;
    cout << "Enter the ending coordinates (x2, y2): ";
    cin >> x2 >> y2;

    // Initialize graphics mode
    initgraph(&gd, &gm, (char*)"");

    // 2. Calculate the differences dx and dy
    int dx = x2 - x1;
    int dy = y2 - y1;

    // 3. Determine the number of steps
    int steps = max(abs(dx), abs(dy));

    // Handle edge case where start and end points are identical
    if (steps == 0) {
        putpixel(x1, y1, WHITE);
    } else {
        // 4. Calculate the x and y increments for each step
        float x_increment = (float)dx / steps;
        float y_increment = (float)dy / steps;

        // 5. Generate intermediate points and plot them on the screen[cite: 1]
        float x = x1;
        float y = y1;

        for (int i = 0; i <= steps; i++) {
            putpixel(round(x), round(y), WHITE); // Plot rounded pixel coordinates
            x += x_increment;
            y += y_increment;
        }
    }

    // 6. Display the final line and hold the screen until a key is pressed[cite: 1]
    getch();
    closegraph();

    return 0;
}
